TMDB_API_KEY=your_tmdb_api_key_here
SECRET_KEY=your_flask_secret_key_here
FLASK_ENV=development

# Telegram Chatbot Notification Configuration
# 1. Create a bot with @BotFather on Telegram -> get TELEGRAM_BOT_TOKEN
# 2. Get your Telegram Chat ID by messaging @userinfobot -> TELEGRAM_ADMIN_CHAT_ID
# 3. Set TELEGRAM_NOTIFICATIONS_ENABLED to true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=987654321
TELEGRAM_NOTIFICATIONS_ENABLED=false
